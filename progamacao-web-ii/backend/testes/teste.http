### Teste 1: Cadastrar cliente (Sucesso)
POST http://localhost:3000/cliente
Content-Type: application/json

{
  "nome": "Pedro Xavier",
  "cpf_cnpj": "11111111111",
  "data_nascimento": "2000-05-15T00:00:00.000Z",
  "telefone": "77999999999",
  "email": "pedro1111111@email.com",
  "url_comprovante_residencia": "https://exemplo.com/comprovante.pdf",
  "logradouro": "Rua A",
  "numero": "100",
  "bairro": "Centro",
  "complemento": "Casa",
  "cidade": "Poções",
  "uf": "BA",
  "cep": "45260000",
  "estado_civil": "solteiro"
}

### Teste 2: Excluir cliente - Sucesso
DELETE http://localhost:3000/cliente/22

### Teste 3: Excluir cliente - ID inexistente
DELETE http://localhost:3000/cliente/999999

### Teste 4: Excluir cliente - ID não numérico
DELETE http://localhost:3000/cliente/abc

### Teste 5: Atualizar cliente - Sucesso
PUT http://localhost:3000/cliente/22
Content-Type: application/json

{
  "nome": "Pedro Xavier Atualizado",
  "telefone": "77999999998"
}

### Teste 6: Atualizar cliente - ID não numérico
PUT http://localhost:3000/cliente/abc
Content-Type: application/json

{
  "nome": "Pedro"
}

### Teste 7: Atualizar cliente - Campo vazio
PUT http://localhost:3000/cliente/22
Content-Type: application/json

{
  "nome": " "
}

### Teste 8: Buscar comprador por ID (id_cliente) - Sucesso
GET http://localhost:3000/comprador/1

### Teste 9: Buscar comprador por ID - Inexistente
GET http://localhost:3000/comprador/999999

### Teste 10: Editar comprador - Sucesso (sem trocar o comprovante)
PUT http://localhost:3000/comprador/1
Content-Type: application/json

{
  "renda_mensal": "5500.00",
  "profissao": "Analista de Sistemas",
  "forma_pagamento": "prazo",
  "tipo_imovel_desejado": "Apartamento",
  "faixa_valor_min": "200000.00",
  "faixa_valor_max": "350000.00",
  "prazo_compra": "2027-12-31",
  "descricao_desejada": "2 quartos",
  "area_minima_desejada": "60",
  "localizacao_desejada": "Centro"
}

### Teste 11: Editar comprador - Forma de pagamento inválida
PUT http://localhost:3000/comprador/1
Content-Type: application/json

{
  "renda_mensal": "5500.00",
  "forma_pagamento": "cartao"
}

